// -p bank-conflicts -x bank-conflicts:report=<out> -b none
import "primitives/core.futil";
import "primitives/memories/comb.futil";
import "primitives/memories/seq.futil";
component disjoint_intervals(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = comb_mem_d1(32, 8, 3);
    r0 = std_reg(32);
    r1 = std_reg(32);
  }
  wires {
    static<2> group sa {
      m.addr0 = %[0:1] ? 3'd0;
      r0.in = m.read_data;
      r0.write_en = %[0:1] ? 1'd1;
    }
    static<2> group sb {
      m.addr0 = %[1:2] ? 3'd1;
      r1.in = m.read_data;
      r1.write_en = %[1:2] ? 1'd1;
    }
  }
  control {
    static par {
      sa;
      sb;
    }
  }
}
component overlapping_intervals(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = comb_mem_d1(32, 8, 3);
    r0 = std_reg(32);
    r1 = std_reg(32);
  }
  wires {
    static<3> group a {
      m.addr0 = %[0:2] ? 3'd0;
      r0.in = m.read_data;
      r0.write_en = %[0:2] ? 1'd1;
    }
    static<3> group b {
      m.addr0 = %[1:2] ? 3'd1;
      r1.in = m.read_data;
      r1.write_en = %[1:2] ? 1'd1;
    }
  }
  control {
    static par {
      a;
      b;
    }
  }
}
component nested_static_par(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = comb_mem_d1(32, 8, 3);
    r0 = std_reg(32);
    r1 = std_reg(32);
  }
  wires {
    static<2> group sa {
      m.addr0 = %[0:1] ? 3'd0;
      r0.in = m.read_data;
      r0.write_en = %[0:1] ? 1'd1;
    }
    static<2> group sb {
      m.addr0 = %[1:2] ? 3'd1;
      r1.in = m.read_data;
      r1.write_en = %[1:2] ? 1'd1;
    }
  }
  control {
    static par {
      static par {
        sa;
      }
      static par {
        sb;
      }
    }
  }
}
component seq_offsets(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = comb_mem_d1(32, 8, 3);
    r0 = std_reg(32);
    r1 = std_reg(32);
    flag = std_reg(1);
  }
  wires {
    static<1> group sa {
      m.addr0 = 3'd0;
      r0.in = m.read_data;
      r0.write_en = 1'd1;
    }
    static<1> group sb {
      flag.in = 1'd1;
      flag.write_en = 1'd1;
    }
    static<1> group sc {
      flag.in = 1'd0;
      flag.write_en = 1'd1;
    }
    static<1> group sd {
      m.addr0 = 3'd1;
      m.write_data = 32'd5;
      m.write_en = 1'd1;
    }
  }
  control {
    static par {
      static seq {
        sa;
        sb;
      }
      static seq {
        sc;
        sd;
      }
    }
  }
}
component interval_chain(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = comb_mem_d1(32, 8, 3);
  }
  wires {
    static<6> group a {
      m.addr0 = %[0:2] ? 3'd0;
    }
    static<6> group b {
      m.addr0 = %[4:6] ? 3'd1;
    }
    static<6> group c {
      m.addr0 = %[1:3] ? 3'd2;
    }
    static<6> group d {
      m.addr0 = %[2:5] ? 3'd3;
    }
  }
  control {
    static par {
      a;
      b;
      c;
      d;
    }
  }
}
component static_complementary_writes(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = comb_mem_d1(32, 8, 3);
    flag = std_reg(1);
  }
  wires {
    static<1> group wt {
      m.addr0 = 3'd0;
      m.write_data = 32'd1;
      m.write_en = flag.out ? 1'd1;
    }
    static<1> group wf {
      m.addr0 = 3'd1;
      m.write_data = 32'd2;
      m.write_en = !flag.out ? 1'd1;
    }
  }
  control {
    static par {
      wt;
      wf;
    }
  }
}
component static_union_guard(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = comb_mem_d1(32, 8, 3);
    r0 = std_reg(32);
    c = std_reg(1);
  }
  wires {
    static<1> group sa {
      m.addr0 = 3'd0;
      m.write_data = 32'd1;
      m.write_en = c.out ? 1'd1;
      m.write_en = !c.out ? 1'd1;
    }
    static<1> group sb {
      m.addr0 = c.out ? 3'd1;
      r0.in = m.read_data;
      r0.write_en = c.out ? 1'd1;
    }
  }
  control {
    static par {
      sa;
      sb;
    }
  }
}
component static_if_arms(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = comb_mem_d1(32, 8, 3);
    flag = std_reg(1);
    r0 = std_reg(32);
    r1 = std_reg(32);
    r2 = std_reg(32);
  }
  wires {
    static<1> group base {
      m.addr0 = 3'd0;
      r0.in = m.read_data;
      r0.write_en = 1'd1;
    }
    static<1> group ra {
      m.addr0 = 3'd1;
      r1.in = m.read_data;
      r1.write_en = 1'd1;
    }
    static<1> group rb {
      m.addr0 = 3'd2;
      r2.in = m.read_data;
      r2.write_en = 1'd1;
    }
  }
  control {
    static par {
      base;
      static if flag.out {
        ra;
      }
      else {
        rb;
      }
    }
  }
}
component static_seq_mem(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    m = seq_mem_d1(32, 8, 3);
    r0 = std_reg(32);
  }
  wires {
    static<1> group readA {
      m.addr0 = 3'd0;
      m.content_en = 1'd1;
      r0.in = m.read_data;
      r0.write_en = 1'd1;
    }
    static<1> group writeB {
      m.addr0 = 3'd1;
      m.content_en = 1'd1;
      m.write_data = 32'd5;
      m.write_en = 1'd1;
    }
  }
  control {
    static par {
      readA;
      writeB;
    }
  }
}
component main() -> () {
  cells {}
  wires {}
  control {}
}
