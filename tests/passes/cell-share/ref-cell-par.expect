import "primitives/compile.futil";
component write_ref(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    ref r = std_reg(32);
  }
  wires {
    group write_r {
      r.in = 32'd4;
      r.write_en = 1'd1;
      write_r[done] = r.done;
    }
  }
  control {
    write_r;
  }
}
component main(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    w = write_ref();
    a = std_reg(32);
    b = std_reg(32);
  }
  wires {
    group write_b {
      b.in = 32'd11;
      b.write_en = 1'd1;
      write_b[done] = b.done;
    }
  }
  control {
    par {
      invoke w[r = a]()();
      write_b;
    }
  }
}
