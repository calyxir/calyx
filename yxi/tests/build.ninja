build-tool = /home/hhe07/.cargo/bin/fud2
rule get-rsrc
  command = $build-tool get-rsrc $out

# calyx_setup (plugin)
calyx-base = /home/hhe07/programming/capra/calyx
calyx-exe = $calyx-base/target/debug/calyx
calyx-lib-path = $calyx-base
args = 
rule calyx
  command = $calyx-exe -l $calyx-lib-path -b $backend $args $in > $out
rule calyx-pass
  command = $calyx-exe -l $calyx-lib-path -p $pass $args $in > $out
cider-calyx-passes = -p none
rule calyx-cider
  command = $calyx-exe -l $calyx-lib-path $cider-calyx-passes $args $in > $out

# yxi_setup (plugin)
yxi = $calyx-base/target/debug/yxi
rule yxi
  command = $yxi -l $calyx-base $in > $out

# wrapper_setup (plugin)
python_args = 
axi-generator = $calyx-base/yxi/axi-calyx/axi_generator.py
python = /home/hhe07/.local/share/fud2/venv/bin/python
rule gen-axi
  command = $python $axi-generator $python_args $in > $out
rule add-import
  command = awk '/import.*/,/import.*/{if (!f){print "import \"$imp-path\";";f=1;print;next}}; 1 ' $in > $out
rule calyx-add-axi
  command = $calyx-exe -l $calyx-lib-path -l $axi-path -p none $args $in > $out
rule calyx-add-axi-with-mem
  command = $calyx-exe -l $calyx-lib-path -l $axi-path -l $mem-path -p none $args $in > $out

# cocotb_setup (plugin)
cocotb-makefile-dir = $calyx-base/yxi/axi-calyx/cocotb
sim_data = axi/vectorized-add.data
cocotb-args = 
rule make-cocotb
  command = make DATA_PATH=$sim_data VERILOG_SOURCE=$in COCOTB_LOG_LEVEL=CRITICAL $cocotb-args > $out
rule copy
  command = cp $in $out
rule cleanup-cocotb
  command = sed -n '/Output:/,/make\[1\]/{/Output:/d;/make\[1\]/d;p;}' $in > $out

# build targets
build seq-vec-add.yxi: yxi axi/read-compute-write/seq-vec-add.futil
build refified_seq-vec-add.futil: calyx-pass axi/read-compute-write/seq-vec-add.futil
  pass = external-to-ref
  args = -x external-to-ref:activate=true -m file
build axi_wrapper.futil: gen-axi seq-vec-add.yxi
build with_axi_refified_seq-vec-add.futil: add-import refified_seq-vec-add.futil | axi_wrapper.futil
  imp-path = axi_wrapper.futil
build calyx_1.futil: calyx-add-axi with_axi_refified_seq-vec-add.futil
  axi-path = axi_wrapper.futil
build verilog-noverify_1.sv: calyx calyx_1.futil
  backend = verilog
  args = --disable-verify $args
build Makefile: copy $cocotb-makefile-dir/Makefile
build axi_test.py: copy $cocotb-makefile-dir/axi_test.py
build run_axi_test.py: copy $cocotb-makefile-dir/run_axi_test.py
build tmp.dat: make-cocotb verilog-noverify_1.sv | Makefile axi_test.py run_axi_test.py
build cocotb-axi_1.dat: cleanup-cocotb tmp.dat

default cocotb-axi_1.dat
