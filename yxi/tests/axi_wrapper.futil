          invoke ar_channel_B0[curr_addr_axi=curr_addr_axi_B0](ARESETn=m_axi_B0_ARESETn, ARREADY=m_axi_B0_ARREADY)(ARVALID=m_axi_B0_ARVALID, ARADDR=m_axi_B0_ARADDR, ARSIZE=m_axi_B0_ARSIZE, ARLEN=m_axi_B0_ARLEN, ARBURST=m_axi_B0_ARBURST);
          invoke read_channel_B0[mem_ref=internal_mem_B0, curr_addr_internal_mem=curr_addr_internal_mem_B0, curr_addr_axi=curr_addr_axi_B0](ARESETn=m_axi_B0_ARESETn, RVALID=m_axi_B0_RVALID, RLAST=m_axi_B0_RLAST, RDATA=m_axi_B0_RDATA, RRESP=m_axi_B0_RRESP)(RREADY=m_axi_B0_RREADY);
