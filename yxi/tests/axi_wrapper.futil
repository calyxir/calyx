        seq {
          invoke aw_channel_A0[curr_addr_axi=curr_addr_axi_A0, max_transfers=max_transfers_A0](ARESETn=m_axi_A0_ARESETn, AWREADY=m_axi_A0_AWREADY)(AWVALID=m_axi_A0_AWVALID, AWADDR=m_axi_A0_AWADDR, AWSIZE=m_axi_A0_AWSIZE, AWLEN=m_axi_A0_AWLEN, AWBURST=m_axi_A0_AWBURST, AWPROT=m_axi_A0_AWPROT);
          invoke write_channel_A0[mem_ref=internal_mem_A0, curr_addr_internal_mem=curr_addr_internal_mem_A0, curr_addr_axi=curr_addr_axi_A0, max_transfers=max_transfers_A0](ARESETn=m_axi_A0_ARESETn, WREADY=m_axi_A0_WREADY)(WVALID=m_axi_A0_WVALID, WLAST=m_axi_A0_WLAST, WDATA=m_axi_A0_WDATA);
          invoke bresp_channel_A0(BVALID=m_axi_A0_BVALID)(BREADY=m_axi_A0_BREADY);
        }
        seq {
          invoke aw_channel_B0[curr_addr_axi=curr_addr_axi_B0, max_transfers=max_transfers_B0](ARESETn=m_axi_B0_ARESETn, AWREADY=m_axi_B0_AWREADY)(AWVALID=m_axi_B0_AWVALID, AWADDR=m_axi_B0_AWADDR, AWSIZE=m_axi_B0_AWSIZE, AWLEN=m_axi_B0_AWLEN, AWBURST=m_axi_B0_AWBURST, AWPROT=m_axi_B0_AWPROT);
          invoke write_channel_B0[mem_ref=internal_mem_B0, curr_addr_internal_mem=curr_addr_internal_mem_B0, curr_addr_axi=curr_addr_axi_B0, max_transfers=max_transfers_B0](ARESETn=m_axi_B0_ARESETn, WREADY=m_axi_B0_WREADY)(WVALID=m_axi_B0_WVALID, WLAST=m_axi_B0_WLAST, WDATA=m_axi_B0_WDATA);
          invoke bresp_channel_B0(BVALID=m_axi_B0_BVALID)(BREADY=m_axi_B0_BREADY);
        }
        seq {
          invoke aw_channel_Sum0[curr_addr_axi=curr_addr_axi_Sum0, max_transfers=max_transfers_Sum0](ARESETn=m_axi_Sum0_ARESETn, AWREADY=m_axi_Sum0_AWREADY)(AWVALID=m_axi_Sum0_AWVALID, AWADDR=m_axi_Sum0_AWADDR, AWSIZE=m_axi_Sum0_AWSIZE, AWLEN=m_axi_Sum0_AWLEN, AWBURST=m_axi_Sum0_AWBURST, AWPROT=m_axi_Sum0_AWPROT);
          invoke write_channel_Sum0[mem_ref=internal_mem_Sum0, curr_addr_internal_mem=curr_addr_internal_mem_Sum0, curr_addr_axi=curr_addr_axi_Sum0, max_transfers=max_transfers_Sum0](ARESETn=m_axi_Sum0_ARESETn, WREADY=m_axi_Sum0_WREADY)(WVALID=m_axi_Sum0_WVALID, WLAST=m_axi_Sum0_WLAST, WDATA=m_axi_Sum0_WDATA);
          invoke bresp_channel_Sum0(BVALID=m_axi_Sum0_BVALID)(BREADY=m_axi_Sum0_BREADY);
        }
      }
    }
  }
}
