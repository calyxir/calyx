    max_transfers_Sum0 = std_reg(8);
    aw_channel_Sum0 = m_aw_channel_32_8();
    write_channel_Sum0 = m_write_channel_32_8();
    bresp_channel_Sum0 = m_bresp_channel_32_8();
  }
  wires {
    m_axi_A0_ARID = 1'd0;
    m_axi_A0_AWID = 1'd0;
    m_axi_A0_WID = 1'd0;
    m_axi_A0_BID = 1'd0;
