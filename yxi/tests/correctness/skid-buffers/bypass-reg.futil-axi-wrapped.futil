component main(@go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1) {
  cells {
    ref in = seq_mem_d1(32, 10, 4);
    b = std_bypass_reg(32);
    i_reg = std_reg(4);
    add0 = std_add(4);
    neq0 = std_neq(4);
    neq1 = std_neq(4);
    and0 = std_and(1);
    ref out = seq_mem_d1(32, 10, 4);
  }
  wires {
    static<1> group init {
      i_reg.write_en = 1'd1;
      i_reg.in = 4'd0;
    }
    static<1> group incr {
      i_reg.write_en = 1'd1;
      i_reg.in = add0.out;
      add0.left = i_reg.out;
      add0.right = 4'd1;
    }
    static<1> group load {
      in.addr0 = i_reg.out;
      in.content_en = 1'd1;
    }
    static<1> group bypass {
      neq0.left = i_reg.out;
      neq0.right = 4'd5;
      neq1.left = i_reg.out;
      neq1.right = 4'd6;
      and0.left = neq0.out;
      and0.right = neq1.out;
      b.write_en = and0.out;
      b.in = in.read_data;
    }
    static<1> group store {
      out.write_en = 1'd1;
      out.content_en = 1'd1;
      out.addr0 = i_reg.out;
      out.write_data = b.out;
    }
  }
  control {
    seq {
      init;
      static repeat 10 {
        static<4> seq  {
          load;
          bypass;
          store;
          incr;
        }
      }
    }
  }
}
component m_ar_channel_32_10(ARESETn: 1, ARREADY: 1, @go go: 1, @clk clk: 1, @reset reset: 1) -> (ARVALID: 1, ARADDR: 64, ARSIZE: 3, ARLEN: 8, ARBURST: 2, ARPROT: 3, @done done: 1) {
  cells {
    arvalid = std_reg(1);
    ar_handshake_occurred = std_reg(1);
    ref curr_addr_axi = std_reg(64);
    arlen = std_reg(8);
    txn_n = std_const(32, 1);
    txn_count = std_reg(32);
    txn_adder = std_add(32);
    bt_reg = std_reg(1);
    perform_reads = std_neq(32);
  }
  wires {
    group do_ar_transfer {
      arvalid.in = !(arvalid.out & ARREADY) & !ar_handshake_occurred.out ? 1'd1;
      arvalid.in = arvalid.out & ARREADY | ar_handshake_occurred.out ? 1'd0;
      arvalid.write_en = 1'd1;
      ar_handshake_occurred.in = arvalid.out & ARREADY ? 1'd1;
      ar_handshake_occurred.write_en = !ar_handshake_occurred.out ? 1'd1;
      ARADDR = curr_addr_axi.out;
      ARSIZE = 3'd2;
      ARLEN = arlen.out;
      ARBURST = 2'd1;
      ARPROT = 3'd6;
      bt_reg.in = ARREADY & arvalid.out ? 1'd1;
      bt_reg.in = !(ARREADY & arvalid.out) ? 1'd0;
      bt_reg.write_en = 1'd1;
      do_ar_transfer[done] = bt_reg.out;
    }
    group incr_txn_count {
      txn_adder.left = txn_count.out;
      txn_adder.right = 32'd1;
      txn_count.in = txn_adder.out;
      txn_count.write_en = 1'd1;
      incr_txn_count[done] = txn_count.done;
    }
    comb group perform_reads_group {
      perform_reads.left = txn_count.out;
      perform_reads.right = txn_n.out;
    }
    ARVALID = arvalid.out;
  }
  control {
    seq {
      invoke txn_count(
        in = 32'd0
      )();
      invoke arlen(
        in = 8'd9
      )();
      while perform_reads.out with perform_reads_group {
        seq {
          par {
            invoke bt_reg(
              in = 1'd0
            )();
            invoke ar_handshake_occurred(
              in = 1'd0
            )();
          }
          do_ar_transfer;
          invoke arvalid(
            in = 1'd0
          )();
          incr_txn_count;
        }
      }
    }
  }
}
component m_aw_channel_32_10(ARESETn: 1, AWREADY: 1, @go go: 1, @clk clk: 1, @reset reset: 1) -> (AWVALID: 1, AWADDR: 64, AWSIZE: 3, AWLEN: 8, AWBURST: 2, AWPROT: 3, @done done: 1) {
  cells {
    awvalid = std_reg(1);
    aw_handshake_occurred = std_reg(1);
    ref curr_addr_axi = std_reg(64);
    awlen = std_reg(8);
    txn_n = std_const(32, 1);
    txn_count = std_reg(32);
    txn_adder = std_add(32);
    bt_reg = std_reg(1);
    perform_writes = std_neq(32);
    ref max_transfers = std_reg(8);
  }
  wires {
    group do_aw_transfer {
      awvalid.in = !(awvalid.out & AWREADY) & !aw_handshake_occurred.out ? 1'd1;
      awvalid.in = awvalid.out & AWREADY | aw_handshake_occurred.out ? 1'd0;
      awvalid.write_en = 1'd1;
      aw_handshake_occurred.in = awvalid.out & AWREADY ? 1'd1;
      aw_handshake_occurred.write_en = !aw_handshake_occurred.out ? 1'd1;
      AWADDR = curr_addr_axi.out;
      AWSIZE = 3'd2;
      AWLEN = awlen.out;
      AWBURST = 2'd1;
      AWPROT = 3'd6;
      bt_reg.in = AWREADY & awvalid.out ? 1'd1;
      bt_reg.in = !(AWREADY & awvalid.out) ? 1'd0;
      bt_reg.write_en = 1'd1;
      do_aw_transfer[done] = bt_reg.out;
      max_transfers.in = 8'd9;
      max_transfers.write_en = 1'd1;
    }
    group incr_txn_count {
      txn_adder.left = txn_count.out;
      txn_adder.right = 32'd1;
      txn_count.in = txn_adder.out;
      txn_count.write_en = 1'd1;
      incr_txn_count[done] = txn_count.done;
    }
    comb group perform_writes_group {
      perform_writes.left = txn_count.out;
      perform_writes.right = txn_n.out;
    }
    AWVALID = awvalid.out;
  }
  control {
    seq {
      invoke txn_count(
        in = 32'd0
      )();
      invoke awlen(
        in = 8'd9
      )();
      while perform_writes.out with perform_writes_group {
        seq {
          par {
            invoke bt_reg(
              in = 1'd0
            )();
            invoke aw_handshake_occurred(
              in = 1'd0
            )();
          }
          do_aw_transfer;
          invoke awvalid(
            in = 1'd0
          )();
          incr_txn_count;
        }
      }
    }
  }
}
component m_read_channel_32_10(ARESETn: 1, RVALID: 1, RLAST: 1, RDATA: 32, RRESP: 2, @go go: 1, @clk clk: 1, @reset reset: 1) -> (RREADY: 1, @done done: 1) {
  cells {
    ref mem_ref = seq_mem_d1(32, 10, 4);
    rready = std_reg(1);
    ref curr_addr_internal_mem = std_reg(4);
    ref curr_addr_axi = std_reg(64);
    n_RLAST = std_reg(1);
    read_data_reg = std_reg(32);
    bt_reg = std_reg(1);
    curr_addr_internal_mem_incr_1_1 = std_add(4);
    curr_addr_axi_incr_4_2 = std_add(64);
  }
  wires {
    group block_transfer {
      rready.in = !(rready.out & RVALID) ? 1'd1;
      rready.in = rready.out & RVALID ? 1'd0;
      rready.write_en = 1'd1;
      read_data_reg.in = RDATA;
      read_data_reg.write_en = rready.out & RVALID ? 1'd1;
      read_data_reg.write_en = !(rready.out & RVALID) ? 1'd0;
      n_RLAST.in = RLAST ? 1'd0;
      n_RLAST.in = !RLAST ? 1'd1;
      n_RLAST.write_en = 1'd1;
      bt_reg.in = rready.out & RVALID ? 1'd1;
      bt_reg.in = !(rready.out & RVALID) ? 1'd0;
      bt_reg.write_en = 1'd1;
      block_transfer[done] = bt_reg.out;
    }
    group service_read_transfer {
      rready.in = 1'd0;
      rready.write_en = 1'd1;
      mem_ref.addr0 = curr_addr_internal_mem.out;
      mem_ref.write_data = read_data_reg.out;
      mem_ref.write_en = 1'd1;
      mem_ref.content_en = 1'd1;
      service_read_transfer[done] = mem_ref.done;
    }
    group curr_addr_internal_mem_incr_1_1_group {
      curr_addr_internal_mem_incr_1_1.left = curr_addr_internal_mem.out;
      curr_addr_internal_mem_incr_1_1.right = 4'd1;
      curr_addr_internal_mem.write_en = 1'd1;
      curr_addr_internal_mem.in = curr_addr_internal_mem_incr_1_1.out;
      curr_addr_internal_mem_incr_1_1_group[done] = curr_addr_internal_mem.done;
    }
    group curr_addr_axi_incr_4_2_group {
      curr_addr_axi_incr_4_2.left = curr_addr_axi.out;
      curr_addr_axi_incr_4_2.right = 64'd4;
      curr_addr_axi.write_en = 1'd1;
      curr_addr_axi.in = curr_addr_axi_incr_4_2.out;
      curr_addr_axi_incr_4_2_group[done] = curr_addr_axi.done;
    }
    RREADY = rready.out;
  }
  control {
    seq {
      invoke n_RLAST(
        in = 1'd1
      )();
      while n_RLAST.out {
        seq {
          invoke bt_reg(
            in = 1'd0
          )();
          block_transfer;
          service_read_transfer;
          par {
            curr_addr_internal_mem_incr_1_1_group;
            curr_addr_axi_incr_4_2_group;
          }
        }
      }
    }
  }
}
component m_write_channel_32_10(ARESETn: 1, WREADY: 1, @go go: 1, @clk clk: 1, @reset reset: 1) -> (WVALID: 1, WLAST: 1, WDATA: 32, @done done: 1) {
  cells {
    ref mem_ref = seq_mem_d1(32, 10, 4);
    wvalid = std_reg(1);
    w_handshake_occurred = std_reg(1);
    ref curr_addr_internal_mem = std_reg(4);
    ref curr_addr_axi = std_reg(64);
    curr_transfer_count = std_reg(8);
    ref max_transfers = std_reg(8);
    n_finished_last_transfer = std_reg(1);
    bt_reg = std_reg(1);
    curr_addr_internal_mem_incr_1_1 = std_add(4);
    curr_addr_axi_incr_4_2 = std_add(64);
    curr_transfer_count_incr_1_3 = std_add(8);
  }
  wires {
    group service_write_transfer {
      wvalid.in = !(wvalid.out & WREADY) & !w_handshake_occurred.out ? 1'd1;
      wvalid.in = wvalid.out & WREADY | w_handshake_occurred.out ? 1'd0;
      wvalid.write_en = 1'd1;
      w_handshake_occurred.in = wvalid.out & WREADY ? 1'd1;
      w_handshake_occurred.in = !(wvalid.out & WREADY) ? 1'd0;
      w_handshake_occurred.write_en = !w_handshake_occurred.out ? 1'd1;
      mem_ref.addr0 = curr_addr_internal_mem.out;
      mem_ref.content_en = 1'd1;
      WDATA = mem_ref.read_data;
      WLAST = max_transfers.out == curr_transfer_count.out ? 1'd1;
      WLAST = max_transfers.out != curr_transfer_count.out ? 1'd0;
      n_finished_last_transfer.in = max_transfers.out == curr_transfer_count.out & wvalid.out & WREADY ? 1'd0;
      n_finished_last_transfer.write_en = max_transfers.out == curr_transfer_count.out & wvalid.out & WREADY ? 1'd1;
      bt_reg.in = wvalid.out & WREADY ? 1'd1;
      bt_reg.in = !(wvalid.out & WREADY) ? 1'd0;
      bt_reg.write_en = 1'd1;
      service_write_transfer[done] = bt_reg.out;
    }
    group curr_addr_internal_mem_incr_1_1_group {
      curr_addr_internal_mem_incr_1_1.left = curr_addr_internal_mem.out;
      curr_addr_internal_mem_incr_1_1.right = 4'd1;
      curr_addr_internal_mem.write_en = 1'd1;
      curr_addr_internal_mem.in = curr_addr_internal_mem_incr_1_1.out;
      curr_addr_internal_mem_incr_1_1_group[done] = curr_addr_internal_mem.done;
    }
    group curr_addr_axi_incr_4_2_group {
      curr_addr_axi_incr_4_2.left = curr_addr_axi.out;
      curr_addr_axi_incr_4_2.right = 64'd4;
      curr_addr_axi.write_en = 1'd1;
      curr_addr_axi.in = curr_addr_axi_incr_4_2.out;
      curr_addr_axi_incr_4_2_group[done] = curr_addr_axi.done;
    }
    group curr_transfer_count_incr_1_3_group {
      curr_transfer_count_incr_1_3.left = curr_transfer_count.out;
      curr_transfer_count_incr_1_3.right = 8'd1;
      curr_transfer_count.write_en = 1'd1;
      curr_transfer_count.in = curr_transfer_count_incr_1_3.out;
      curr_transfer_count_incr_1_3_group[done] = curr_transfer_count.done;
    }
    WVALID = wvalid.out;
    mem_ref.write_en = 1'd0;
  }
  control {
    seq {
      invoke curr_addr_internal_mem(
        in = 4'd0
      )();
      invoke n_finished_last_transfer(
        in = 1'd1
      )();
      while n_finished_last_transfer.out {
        seq {
          invoke bt_reg(
            in = 1'd0
          )();
          service_write_transfer;
          par {
            curr_addr_internal_mem_incr_1_1_group;
            curr_transfer_count_incr_1_3_group;
            curr_addr_axi_incr_4_2_group;
            invoke w_handshake_occurred(
              in = 1'd0
            )();
          }
        }
      }
    }
  }
}
component m_bresp_channel_32_10(ARESETn: 1, BVALID: 1, @go go: 1, @clk clk: 1, @reset reset: 1) -> (BREADY: 1, @done done: 1) {
  cells {
    bready = std_reg(1);
    bt_reg = std_reg(1);
  }
  wires {
    group block_transfer {
      bready.in = !(bready.out & BVALID) ? 1'd1;
      bready.in = bready.out & BVALID ? 1'd0;
      bready.write_en = 1'd1;
      bt_reg.in = bready.out & BVALID ? 1'd1;
      bt_reg.in = !(bready.out & BVALID) ? 1'd0;
      bt_reg.write_en = 1'd1;
      block_transfer[done] = bt_reg.out;
    }
    BREADY = bready.out;
  }
  control {
    seq {
      invoke bt_reg(
        in = 1'd0
      )();
      block_transfer;
    }
  }
}
component Toplevel<"toplevel"=1>(@clk ap_clk: 1, m_axi_in_ARESETn: 1, m_axi_in_ARREADY: 1, m_axi_in_RVALID: 1, m_axi_in_RLAST: 1, m_axi_in_RDATA: 32, m_axi_in_RRESP: 2, m_axi_in_AWREADY: 1, m_axi_in_WRESP: 2, m_axi_in_WREADY: 1, m_axi_in_BVALID: 1, m_axi_in_BRESP: 2, m_axi_in_RID: 1, m_axi_out_ARESETn: 1, m_axi_out_ARREADY: 1, m_axi_out_RVALID: 1, m_axi_out_RLAST: 1, m_axi_out_RDATA: 32, m_axi_out_RRESP: 2, m_axi_out_AWREADY: 1, m_axi_out_WRESP: 2, m_axi_out_WREADY: 1, m_axi_out_BVALID: 1, m_axi_out_BRESP: 2, m_axi_out_RID: 1, @go go: 1, @reset reset: 1) -> (m_axi_in_ARVALID: 1, m_axi_in_ARADDR: 64, m_axi_in_ARSIZE: 3, m_axi_in_ARLEN: 8, m_axi_in_ARBURST: 2, m_axi_in_RREADY: 1, m_axi_in_AWVALID: 1, m_axi_in_AWADDR: 64, m_axi_in_AWSIZE: 3, m_axi_in_AWLEN: 8, m_axi_in_AWBURST: 2, m_axi_in_AWPROT: 3, m_axi_in_WVALID: 1, m_axi_in_WLAST: 1, m_axi_in_WDATA: 32, m_axi_in_BREADY: 1, m_axi_in_ARID: 1, m_axi_in_AWID: 1, m_axi_in_WID: 1, m_axi_in_BID: 1, m_axi_out_ARVALID: 1, m_axi_out_ARADDR: 64, m_axi_out_ARSIZE: 3, m_axi_out_ARLEN: 8, m_axi_out_ARBURST: 2, m_axi_out_RREADY: 1, m_axi_out_AWVALID: 1, m_axi_out_AWADDR: 64, m_axi_out_AWSIZE: 3, m_axi_out_AWLEN: 8, m_axi_out_AWBURST: 2, m_axi_out_AWPROT: 3, m_axi_out_WVALID: 1, m_axi_out_WLAST: 1, m_axi_out_WDATA: 32, m_axi_out_BREADY: 1, m_axi_out_ARID: 1, m_axi_out_AWID: 1, m_axi_out_WID: 1, m_axi_out_BID: 1, @done done: 1) {
  cells {
    main_compute = main();
    curr_addr_internal_mem_in = std_reg(4);
    curr_addr_axi_in = std_reg(64);
    ar_channel_in = m_ar_channel_32_10();
    read_channel_in = m_read_channel_32_10();
    internal_mem_in = seq_mem_d1(32, 10, 4);
    max_transfers_in = std_reg(8);
    aw_channel_in = m_aw_channel_32_10();
    write_channel_in = m_write_channel_32_10();
    bresp_channel_in = m_bresp_channel_32_10();
    curr_addr_internal_mem_out = std_reg(4);
    curr_addr_axi_out = std_reg(64);
    ar_channel_out = m_ar_channel_32_10();
    read_channel_out = m_read_channel_32_10();
    internal_mem_out = seq_mem_d1(32, 10, 4);
    max_transfers_out = std_reg(8);
    aw_channel_out = m_aw_channel_32_10();
    write_channel_out = m_write_channel_32_10();
    bresp_channel_out = m_bresp_channel_32_10();
  }
  wires {
    m_axi_in_ARID = 1'd0;
    m_axi_in_AWID = 1'd0;
    m_axi_in_WID = 1'd0;
    m_axi_in_BID = 1'd0;
    m_axi_out_ARID = 1'd0;
    m_axi_out_AWID = 1'd0;
    m_axi_out_WID = 1'd0;
    m_axi_out_BID = 1'd0;
  }
  control {
    seq {
      par {
        invoke curr_addr_axi_in(
          in = 64'd4096
        )();
        invoke curr_addr_axi_out(
          in = 64'd4096
        )();
      }
      par {
        invoke curr_addr_internal_mem_in(
          in = 4'd0
        )();
        invoke curr_addr_internal_mem_out(
          in = 4'd0
        )();
      }
      par {
        seq {
          invoke ar_channel_in[curr_addr_axi = curr_addr_axi_in](
            ARESETn = m_axi_in_ARESETn,
            ARREADY = m_axi_in_ARREADY
          )(
            ARVALID = m_axi_in_ARVALID,
            ARADDR = m_axi_in_ARADDR,
            ARSIZE = m_axi_in_ARSIZE,
            ARLEN = m_axi_in_ARLEN,
            ARBURST = m_axi_in_ARBURST
          );
          invoke read_channel_in[mem_ref = internal_mem_in,curr_addr_internal_mem = curr_addr_internal_mem_in,curr_addr_axi = curr_addr_axi_in](
            ARESETn = m_axi_in_ARESETn,
            RVALID = m_axi_in_RVALID,
            RLAST = m_axi_in_RLAST,
            RDATA = m_axi_in_RDATA,
            RRESP = m_axi_in_RRESP
          )(
            RREADY = m_axi_in_RREADY
          );
        }
        seq {
          invoke ar_channel_out[curr_addr_axi = curr_addr_axi_out](
            ARESETn = m_axi_out_ARESETn,
            ARREADY = m_axi_out_ARREADY
          )(
            ARVALID = m_axi_out_ARVALID,
            ARADDR = m_axi_out_ARADDR,
            ARSIZE = m_axi_out_ARSIZE,
            ARLEN = m_axi_out_ARLEN,
            ARBURST = m_axi_out_ARBURST
          );
          invoke read_channel_out[mem_ref = internal_mem_out,curr_addr_internal_mem = curr_addr_internal_mem_out,curr_addr_axi = curr_addr_axi_out](
            ARESETn = m_axi_out_ARESETn,
            RVALID = m_axi_out_RVALID,
            RLAST = m_axi_out_RLAST,
            RDATA = m_axi_out_RDATA,
            RRESP = m_axi_out_RRESP
          )(
            RREADY = m_axi_out_RREADY
          );
        }
      }
      invoke main_compute[in = internal_mem_in,out = internal_mem_out]()();
      par {
        invoke curr_addr_axi_in(
          in = 64'd4096
        )();
        invoke curr_addr_axi_out(
          in = 64'd4096
        )();
      }
      par {
        seq {
          invoke aw_channel_in[curr_addr_axi = curr_addr_axi_in,max_transfers = max_transfers_in](
            ARESETn = m_axi_in_ARESETn,
            AWREADY = m_axi_in_AWREADY
          )(
            AWVALID = m_axi_in_AWVALID,
            AWADDR = m_axi_in_AWADDR,
            AWSIZE = m_axi_in_AWSIZE,
            AWLEN = m_axi_in_AWLEN,
            AWBURST = m_axi_in_AWBURST,
            AWPROT = m_axi_in_AWPROT
          );
          invoke write_channel_in[mem_ref = internal_mem_in,curr_addr_internal_mem = curr_addr_internal_mem_in,curr_addr_axi = curr_addr_axi_in,max_transfers = max_transfers_in](
            ARESETn = m_axi_in_ARESETn,
            WREADY = m_axi_in_WREADY
          )(
            WVALID = m_axi_in_WVALID,
            WLAST = m_axi_in_WLAST,
            WDATA = m_axi_in_WDATA
          );
          invoke bresp_channel_in(
            BVALID = m_axi_in_BVALID
          )(
            BREADY = m_axi_in_BREADY
          );
        }
        seq {
          invoke aw_channel_out[curr_addr_axi = curr_addr_axi_out,max_transfers = max_transfers_out](
            ARESETn = m_axi_out_ARESETn,
            AWREADY = m_axi_out_AWREADY
          )(
            AWVALID = m_axi_out_AWVALID,
            AWADDR = m_axi_out_AWADDR,
            AWSIZE = m_axi_out_AWSIZE,
            AWLEN = m_axi_out_AWLEN,
            AWBURST = m_axi_out_AWBURST,
            AWPROT = m_axi_out_AWPROT
          );
          invoke write_channel_out[mem_ref = internal_mem_out,curr_addr_internal_mem = curr_addr_internal_mem_out,curr_addr_axi = curr_addr_axi_out,max_transfers = max_transfers_out](
            ARESETn = m_axi_out_ARESETn,
            WREADY = m_axi_out_WREADY
          )(
            WVALID = m_axi_out_WVALID,
            WLAST = m_axi_out_WLAST,
            WDATA = m_axi_out_WDATA
          );
          invoke bresp_channel_out(
            BVALID = m_axi_out_BVALID
          )(
            BREADY = m_axi_out_BREADY
          );
        }
      }
    }
  }
}
